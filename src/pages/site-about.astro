---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const siteAboutPost = await getEntry("spec", "site-about");

if (!siteAboutPost) {
	throw new Error("Site about page content not found");
}

const { Content } = await render(siteAboutPost);
const title = "站点介绍";
const description =
	siteAboutPost.data.description || "了解本站的定位与内容方向。";
---

<MainGridLayout title={title} description={description}>
	<div class="flex min-h-32 w-full overflow-hidden rounded-(--radius-large) relative">
		<div class="card-base z-10 w-full px-9 py-6 relative">
			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
